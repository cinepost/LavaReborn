#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)
def Xform "World" {
    def Camera "Camera" {
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 20.25
        float2 clippingRange = (0.01, 1000)
        double3 xformOp:translate = (0, 1.5, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Mesh "Ground" {
        point3f[] points = [(-5,0,-5),(-5,0,5),(5,0,5),(5,0,-5)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        color3f[] primvars:displayColor = [(0.65,0.65,0.65)]
        uniform token subdivisionScheme = "none"
    }
    def Mesh "Triangle" {
        point3f[] points = [(-0.8,0,0),(0.8,0,0),(0,2,0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0,1,2]
        color3f[] primvars:displayColor = [(0.75,0.12,0.05)]
        uniform token subdivisionScheme = "none"
    }
    def SphereLight "Key" {
        float inputs:intensity = 120
        color3f inputs:color = (1,0.88,0.72)
        double3 xformOp:translate = (-2,4,2)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
