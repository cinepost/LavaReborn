#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "geometry.glsl"
#include "light_bvh.glsl"
#include "camera.glsl"
#include "materials/visibility.glsl"
#include "query.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
// Retain the unified traversal as a specialization product for regression / timing.
layout(constant_id=50) const bool polygonFirst=false;
void main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(p, uvec2(pc.width, pc.height))))
    return;
  uint i=p.y*pc.width+p.x;
  vec3 origin, direction; float planeScale;
  cameraRay(p, origin, direction, planeScale);
  float tmin=camera.clippingOffset.x*planeScale;
  float closest=camera.clippingOffset.y*planeScale;
  uint primitive=0xffffffffu;vec2 bary=vec2(0);
  rayQueryEXT q;
  if(!polygonFirst){
    rayQueryInitializeEXT(q,world,0u,255u,origin,tmin,direction,closest);
    while(rayQueryProceedEXT(q))confirmCandidate(q,tmin,closest,true);
    if(rayQueryGetIntersectionTypeEXT(q,true)!=gl_RayQueryCommittedIntersectionNoneEXT){
      primitive=queryPrimitive(q);bary=queryCoordinates(q);
      closest=rayQueryGetIntersectionTEXT(q,true);
    }
  }else{
  // Exact current-sample polygon depth bounds the entire curve traversal.
  // Unlike a previous-frame / coarse Hi-Z value this is safe for lens jitter,
  // cutouts, silhouettes, camera motion and orthographic cameras.
  if(pc.meshTriangles>0u){
    rayQueryInitializeEXT(q,world,0u,1u,origin,tmin,direction,closest);
    while(rayQueryProceedEXT(q))confirmCandidate(q,tmin,closest,true);
    if(rayQueryGetIntersectionTypeEXT(q,true)!=gl_RayQueryCommittedIntersectionNoneEXT){
      primitive=queryPrimitive(q);bary=queryCoordinates(q);
      closest=rayQueryGetIntersectionTEXT(q,true);
    }
  }
  if(pc.curveCount>0u&&closest>tmin){
    rayQueryInitializeEXT(q,world,0u,2u,origin,tmin,direction,closest);
    while(rayQueryProceedEXT(q))confirmCandidate(q,tmin,closest,true);
    if(rayQueryGetIntersectionTypeEXT(q,true)!=gl_RayQueryCommittedIntersectionNoneEXT){
      primitive=queryPrimitive(q);bary=queryCoordinates(q);
      closest=rayQueryGetIntersectionTEXT(q,true);
    }
  }
  }
  hits[i]=Hit(0,0.,0.,0.,uvec4(0));
  if(primitive!=0xffffffffu){
    hits[i]=Hit(primitive+1u,bary.x,bary.y,closest/planeScale,uvec4(0));
    Triangle t=hitTriangle(primitive,bary,origin,direction);
    vec2 uv=t.uv01.xy*(1.-bary.x-bary.y)+t.uv01.zw*bary.x+t.uv2.xy*bary.y;
    hits[i].attributes=uvec4(materialId(primitive),floatBitsToUint(uv),0);
  }
  uint emitter;
  if (tracePrimaryLights(origin,direction,camera.clippingOffset.x*planeScale,closest,emitter))
    hits[i]=Hit(0x80000000u|emitter,0.,0.,closest/planeScale,uvec4(0));
}
