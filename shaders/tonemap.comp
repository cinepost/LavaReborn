#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
vec3 srgb(vec3 x) {
  return mix(12.92 * x, 1.055 * pow(max(x, vec3(0)), vec3(1. / 2.4)) - .055,
             step(vec3(.0031308), x));
}
void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(p, ivec2(pc.width, pc.height))))
    return;
  uint i = uint(p.y) * pc.width + uint(p.x);
  vec3 color = max(vec3(0), filtered[i].rgb * exp2(pc.exposure));
  float depth =
      hits[i].primitive == 0u ? camera.clippingOffset.y : hits[i].distance;
  display[pc.width * pc.height + i] = vec4(depth, 0, 0, 0);
  if (pc.linearOutput != 0u) {
    display[i] = vec4(color, 1);
    return;
  }
  color = clamp((color * (2.51 * color + .03)) /
                    (color * (2.43 * color + .59) + .14),
                0., 1.);
  display[i] = vec4(srgb(color), 1);
}
