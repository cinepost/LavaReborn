#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "common.glsl"
#include "queue.glsl"
#include "queue_compact.glsl"
layout(local_size_x=64) in;
void main() {
 uint index=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64u+gl_LocalInvocationIndex;
 PathRay ray=PathRay(vec4(0),vec4(0),vec4(0),uvec4(0));
 bool alive=false;
 if(index<counts[0]) {
  ray=raysA[index];
  alive=pc.filterPhase==0u&&index%3u!=0u&&(index/64u%3u!=1u||index%64u<12u);
 }
 compactRays(ray,alive);
}
