#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
void main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(p, uvec2(pc.width, pc.height))))
    return;
  uint i = p.y * pc.width + p.x;
  if (pc.filterPhase != 0u) {
    vec3 sum = vec3(0);
    float weights = 0.;
    // Conservative primitive-aware spatial filter over accumulated linear
    // HDR.
    int r = int(pc.radius);
    for (int y = -r; y <= r; y++)
      for (int x = -r; x <= r; x++) {
        ivec2 q = ivec2(p) + ivec2(x, y);
        if (any(lessThan(q, ivec2(0))) ||
            any(greaterThanEqual(q, ivec2(pc.width, pc.height))))
          continue;
        uint j = uint(q.y) * pc.width + uint(q.x);
        if (hits[i].primitive != hits[j].primitive)
          continue;
        float w = exp(-float(x * x + y * y) * .5);
        sum += history[j].rgb * w;
        weights += w;
      }

    filtered[i] = vec4(sum / max(weights, 1e-6), 1);
    return;
  }
  // No history read on sample zero, including after resize / scene edits.
  history[i] = pc.sampleIndex == 0 ? radiance[i]
                                   : mix(history[i], radiance[i],
                                         1. / float(pc.sampleIndex + 1u));
}
